file(READ "${INPUT}" HEXDATA HEX)
string(LENGTH "${HEXDATA}" LENGTH)
math(EXPR END "${LENGTH}-8")
set(TEXT "#pragma once\n#include <cstdint>\nstatic constexpr uint32_t local_remap_spirv[] = {\n")
foreach(OFFSET RANGE 0 ${END} 8)
  string(SUBSTRING "${HEXDATA}" ${OFFSET} 8 WORD)
  string(SUBSTRING "${WORD}" 0 2 B0)
  string(SUBSTRING "${WORD}" 2 2 B1)
  string(SUBSTRING "${WORD}" 4 2 B2)
  string(SUBSTRING "${WORD}" 6 2 B3)
  string(APPEND TEXT "0x${B3}${B2}${B1}${B0}u,\n")
endforeach()
string(APPEND TEXT "};\n")
file(WRITE "${OUTPUT}" "${TEXT}")
